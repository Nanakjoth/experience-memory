# ---------------------------------------------------------------------------
# MemoryOS — example environment
#
# Copy to `backend/.env` (or `.env` at the repo root) and edit as needed:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real keys.
#
# EVERY value below has a working default. With no .env at all, MemoryOS runs
# fully offline against the SIMULATED memory engine. You only need to change
# something here if you want the real Hindsight engine.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=MemoryOS
APP_SUBTITLE=Knowledge Continuity for Organizations
ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API.
# Add your deployed frontend origin here (e.g. https://your-app.web.app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Memory engine (Hindsight) ------------------------------------------------
# Base URL of a running Hindsight server. See docker-compose.hindsight.yml.
HINDSIGHT_BASE_URL=http://localhost:8888

# The dedicated memory bank this app reads and writes.
HINDSIGHT_BANK_ID=memoryos-novatech

# Optional. Sent as a bearer token to Hindsight when set.
HINDSIGHT_API_KEY=

# Seconds to wait on a single Hindsight call before giving up.
HINDSIGHT_TIMEOUT=60

# Set to true to force the SIMULATED engine even when Hindsight is reachable.
# Useful for deterministic tests and offline demos.
FORCE_SIMULATED_ENGINE=false

# Consecutive live-engine failures before MemoryOS degrades to SIMULATED.
LIVE_FAILURE_THRESHOLD=2

# --- Storage ------------------------------------------------------------------
# SQLite files holding application metadata (memories, events, evidence,
# contradictions, audit trail). Created automatically on first run.
APP_DB_PATH=backend/data/memoryos.db
SIMULATED_DB_PATH=backend/data/hindsight_sim.db

# --- Optional answer polishing ------------------------------------------------
# `none` (default) means no external LLM is called; the reflection layer builds
# its answer from retrieved evidence alone. Set to a provider name only if you
# have wired an LLM client into backend/memory/reflection.py.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Behaviour ----------------------------------------------------------------
# Which identity the UI acts as before anyone picks one from the actor switcher.
# Switching the actor is what drives the permission/privacy demonstration.
DEFAULT_ACTOR=maya

# Reasoning budget passed to the memory engine on recall and reflect calls.
RECALL_BUDGET=mid
REFLECT_BUDGET=low

RECALL_MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=30
